{
  "name": "@stargazy/feedpulse-rn",
  "version": "0.2.0",
  "description": "Feedpulse React Native SDK (headless): config, app attestation, submit, identify, and the optional target picker.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src",
    "!src/__tests__",
    "ios",
    "android",
    "feedpulse-react-native.podspec",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "lint": "oxlint"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.0",
    "@types/react": "^18.2.0",
    "jest": "^29.7.0",
    "oxlint": "^1.95.0",
    "oxlint-tsgolint": "^7.0.2008",
    "react": "^18.2.0",
    "react-native": "^0.74.0",
    "typescript": "^7.0.2"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "@swc/jest",
        {
          "jsc": {
            "parser": {
              "syntax": "typescript"
            },
            "target": "es2020"
          },
          "module": {
            "type": "commonjs"
          }
        }
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lv-kit/feedpulse-rn.git"
  },
  "license": "MIT"
}
